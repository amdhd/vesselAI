# =============================================================================
# VesselMind AI — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://vesselmind:vesselmind_secret@localhost:5432/vesselmind
POSTGRES_USER=vesselmind
POSTGRES_PASSWORD=vesselmind_secret
POSTGRES_DB=vesselmind

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Anthropic Claude API (REQUIRED for AI features)
# Get your key at: https://console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Number of reverse-proxy hops to trust for the client IP (e.g. 1 behind a
# single load balancer). Enables correct IP-based rate limiting. Leave unset
# when NOT behind a proxy — trusting X-Forwarded-For directly lets clients
# spoof their IP and bypass limits.
# TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Frontend (Vite)
# These are prefixed with VITE_ so they are exposed to the browser
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001
# Fleet Analytics (FastAPI over the DuckDB gold layer) — a SEPARATE service from
# the Express API above. Local dev runs it on :8000; production builds set this
# to "/" so nginx proxies /api/analytics to it same-origin. Must never be empty:
# any falsy value falls back to http://localhost:8000, which in a deployed app
# would point the browser at the visitor's own machine.
VITE_ANALYTICS_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Optional: External APIs (mock data used if not provided)
# -----------------------------------------------------------------------------
# StormGlass API for real weather data
STORMGLASS_API_KEY=

# MarineTraffic API for real AIS vessel tracking
MARINETRAFFIC_API_KEY=

# OpenWeatherMap fallback
OPENWEATHERMAP_API_KEY=

# -----------------------------------------------------------------------------
# Demo Mode (pre-seeded in DB — no config needed)
# Demo credentials:
#   Email: demo@petronas.com
#   Password: demo123
# -----------------------------------------------------------------------------
