# syntax=docker/dockerfile:1

# Production image for the VesselMind web app.
# Stage 1 builds the static bundle; stage 2 serves it from a non-root nginx.

# ---- build ----
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Baked into the bundle at build time. Defaults to same-origin "/api" so the
# nginx below can reverse-proxy the API (no CORS, no hardcoded backend host).
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
# Same-origin too: nginx routes /api/analytics/ to the analytics service. Must be
# "/" and not empty — the client falls back to http://localhost:8000 on any falsy
# value, which would point a deployed browser at the user's own machine.
ARG VITE_ANALYTICS_API_URL=/
ENV VITE_ANALYTICS_API_URL=$VITE_ANALYTICS_API_URL
RUN npm run build

# ---- runtime: non-root nginx (uid 101, listens on 8080) ----
# Base bumped from 1.27-alpine after a Trivy scan found 33 fixable HIGH/CRITICAL
# findings across 10 Alpine packages — including CRITICAL OpenSSL (libssl3,
# libcrypto3). None of them are ours: they are OS packages in the base image, and
# the only lever is which base you pick and how fresh it is.
#
# `apk upgrade` on top catches anything the tag itself has not picked up yet.
# Tradeoff, stated plainly: it makes the build non-reproducible — the same
# Dockerfile builds different bytes tomorrow. For a base image you rebuild and
# rescan on every CI run that is the right trade; for a pinned artifact it would
# not be.
FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime
# This stage already ran `apk upgrade` and STILL shipped CVE-2026-14456. The
# upgrade was never the problem -- Docker restored the layer from the GHA cache
# and never re-executed it. APK_REFRESH busts that layer; see the longer note in
# backend/Dockerfile.prod.
ARG APK_REFRESH=0
USER root
RUN apk upgrade --no-cache
USER 101
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
