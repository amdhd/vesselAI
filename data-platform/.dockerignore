# Keeps the build context small (~KB instead of ~1.6GB). Without this, Docker
# would upload the local .venv, the 850MB generated warehouse and the full raw
# NOAA download — none of which belong in an image that rebuilds the warehouse
# from the tracked sample anyway.

# --- Python ---
.venv/
.venv-dashboard/
__pycache__/
*.pyc
.pytest_cache/

# --- Generated warehouse (the build stage regenerates it) ---
data/*.duckdb
data/*.duckdb.wal

# --- Raw data: exclude the large downloads, keep ONLY the tracked sample the
#     pipeline builds from. The negation must follow the broad ignore. ---
data/raw/*
!data/raw/ais_sample.csv
data/*.csv

# --- dbt build artefacts (regenerated by `dbt build`) ---
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# --- Local-only ---
.DS_Store
README.md
dashboard.py
requirements-dashboard.txt
notebooks_or_scripts/
