# syntax=docker/dockerfile:1

# Production image for the VesselMind API.
# Stages:
#   deps    — full install + generated Prisma client
#   build   — compiled TypeScript (retains dev deps incl. ts-node, so a
#             migrate+seed one-off can target this stage)
#
# NOTE, corrected after actually checking the image: the Prisma CLI is NOT
# removed by the prune stage. `@prisma/client` declares `prisma` as an optional
# peer dependency, so npm keeps it in the production tree and the runtime image
# ships a working `node_modules/.bin/prisma` (5.22.0). Migrations alone could
# therefore run from this image. Seeding could not — it needs ts-node, which the
# prune genuinely does remove — which is why the one-off Job still targets the
# `build` stage.
#   prune   — production-only node_modules (keeps the generated Prisma client)
#   runtime — slim, non-root final image

# ---- deps ----
FROM node:20-alpine AS deps
WORKDIR /app
# Prisma's schema + query engines are dynamically linked against OpenSSL, which
# node:20-alpine does not ship. Without it `prisma migrate deploy` dies with
# "Could not parse schema engine response", so migrations — and therefore the
# whole prod stack — never come up.
RUN apk add --no-cache openssl
COPY package*.json ./
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate

# ---- build ----
FROM deps AS build
COPY . .
RUN npm run build

# ---- migrate: the image the Kubernetes db-init Job runs ----
#
# Identical to `build` except npm is removed. The Job invokes
# node_modules/.bin/prisma and node_modules/.bin/ts-node directly — never npm,
# never npx — so npm is dead weight in the shipped artifact, and node:alpine
# ships npm with its own vendored dependency tree (tar, minimatch, sigstore,
# glob, cross-spawn, brace-expansion, ip-address). A Trivy scan of this stage
# failed on 18 HIGH/CRITICAL findings, every one of them inside npm's vendor
# directory and none reachable by anything this Job runs.
#
# Same reasoning as the runtime stage below: an unused tool is better removed
# than patched. The vulnerabilities leave with it, and a compromised migration
# pod loses a convenient way to install more code.
#
# It is a SEPARATE stage rather than deleting npm inside `build`, because the
# `prune` stage below is FROM build and needs `npm prune` to work — and
# docker-compose.prod.yml targets `build` for its migrate/seed one-offs, which
# call npx and genuinely need npm.
FROM build AS migrate
# Same OS-package patching as the runtime stage; this stage is scanned and
# published in its own right (matrix target: migrate), so it needs it too.
ARG APK_REFRESH=0
RUN apk upgrade --no-cache
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# ---- prune (production node_modules only; generated client is preserved) ----
FROM build AS prune
RUN npm prune --omit=dev

# ---- runtime: slim, non-root ----
FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

# dumb-init gives us a real PID 1 that reaps zombies and forwards SIGTERM,
# so the orchestrator can shut the app down cleanly.
# openssl: the Prisma *query* engine needs it at runtime too, not just for
# migrations. dumb-init gives us a real PID 1 (see below).
# Patch OS packages that the base image has fallen behind on.
#
# APK_REFRESH exists ONLY to bust Docker's layer cache. `--no-cache` is an APK
# flag -- it stops apk caching its package index -- and does NOTHING about the
# Docker layer, which is what actually gets reused. With cache-from/cache-to
# type=gha in CI, an `apk upgrade` layer is restored from cache and never
# re-executes, so it stays frozen at whatever package versions existed when it
# was first built. That is how CVE-2026-14456 (libcrypto3 3.5.7-r0, fixed in
# 3.5.8-r0) survived an image that already ran `apk upgrade`.
#
# CI passes the run id, so this layer re-runs every build. Everything below it
# is cheap to rebuild, which is why it sits here rather than earlier.
ARG APK_REFRESH=0
RUN apk add --no-cache dumb-init openssl && apk upgrade --no-cache

# Remove npm and npx from the runtime image. The container's command is
# `node dist/server.js` — npm is never invoked, but node:20-alpine ships it
# along with its own bundled dependency tree, which is where a Trivy scan found
# six vulnerable packages including the image's only CRITICAL (node-tar).
# Deleting an unused tool is a better fix than patching it: the vulnerabilities
# leave with it, the image shrinks, and there is one less way to execute
# arbitrary code inside a compromised container.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

COPY --from=prune /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/package.json ./package.json

# node:alpine ships an unprivileged `node` user — run as it, never as root.
USER node

EXPOSE 3001

# Liveness probe hits the app's own health endpoint (Node 20 has global fetch).
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["dumb-init", "node", "dist/server.js"]
